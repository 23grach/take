{
  "$comment": "Just the page: no window, no backdrop. With target.viewport [1920, 1080] the page fills the 1920×1080 video one to one; another viewport is scaled to fit and centred on the background colour. Times in frames at 60 fps.",
  "stage": {
    "size": [1920, 1080],
    "output": [1920, 1080],
    "background": "#ffffff",
    "padding": 0
  },
  "window": {
    "radius": 0,
    "shadow": "none",
    "border": "none",
    "bar": { "height": 0, "background": "none", "divider": "transparent" },
    "dots": { "size": 0, "gap": 0, "outlineWidth": 0, "close": { "fill": "transparent", "outline": "transparent" }, "minimize": { "fill": "transparent", "outline": "transparent" }, "zoom": { "fill": "transparent", "outline": "transparent" } },
    "address": { "show": false, "width": 0, "height": 0, "background": "none", "color": "transparent", "font": "13px system-ui, sans-serif" }
  },
  "cursor": {
    "$comment": "Same as the default theme: the page's own CSS cursor, macOS's drawings on a Mac, the shapes below elsewhere.",
    "art": "system",
    "size": 24,
    "pressScale": 0.86,
    "hideFade": 8,
    "shapes": {
      "arrow": { "file": "cursor.svg", "hotspot": [3, 3] },
      "hand": { "file": "cursor-hand.svg", "hotspot": [11, 3] },
      "text": { "file": "cursor-text.svg", "hotspot": [15, 15] }
    }
  },
  "caret": { "width": 1, "solidFrames": 30, "blinkFrames": 30 },
  "loop": { "frames": 40 }
}
