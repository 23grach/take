{
  "stage": {
    "size": [1920, 1080],
    "output": [1920, 1080],
    "background": "#ffffff",
    "padding": 0
  },
  "window": {
    "radius": 0,
    "background": "#ffffff",
    "shadow": "none",
    "border": "none",
    "bar": { "height": 0, "padding": [0, 0], "background": "none", "divider": "transparent" },
    "dots": { "size": 0, "gap": 0, "outlineWidth": 0, "close": { "fill": "transparent", "outline": "transparent" }, "minimize": { "fill": "transparent", "outline": "transparent" }, "zoom": { "fill": "transparent", "outline": "transparent" } },
    "address": { "show": false, "width": 0, "color": "transparent", "font": "13px system-ui, sans-serif" }
  },
  "cursor": {
    "art": "system",
    "size": 24,
    "pressScale": 0.98,
    "morph": 18,
    "hideFade": 8,
    "shapes": {
      "arrow": { "file": "cursor.svg", "hotspot": [3, 3] },
      "hand": { "file": "cursor-hand.svg", "hotspot": [11, 3] },
      "text": { "file": "cursor-text.svg", "hotspot": [15, 15] }
    }
  },
  "caret": { "width": 1, "solidFrames": 30, "blinkFrames": 30 },
  "loop": { "frames": 40 },
  "appearance": { "frames": 42 },
  "focus": { "size": [1920, 1080], "background": "#ffffff", "maxZoom": 5 },
  "dark": { "focus": { "background": "#000000" } }
}
