{
  "stage": {
    "size": [1920, 1080],
    "output": [2560, 1440],
    "background": "#f5f5f5",
    "padding": 64
  },
  "window": {
    "radius": 14,
    "shadow": "0 1px 2px rgb(0 0 0 / 0.05), 0 12px 32px -6px rgb(0 0 0 / 0.12)",
    "border": "1px solid #e6e6e6",
    "bar": { "height": 40, "background": "#f3f2f0", "divider": "#e3e1dc" },
    "dots": {
      "size": 12,
      "gap": 8,
      "outlineWidth": 0.5,
      "close": { "fill": "#ff5f57", "outline": "#e0443e" },
      "minimize": { "fill": "#febc2e", "outline": "#dea123" },
      "zoom": { "fill": "#28c840", "outline": "#1aab29" }
    },
    "address": { "show": true, "width": 420, "height": 26, "background": "#ffffff", "color": "#8a8794", "font": "500 13px system-ui, -apple-system, sans-serif" }
  },
  "cursor": {
    "art": "system",
    "size": 24,
    "pressScale": 0.86,
    "hideFade": 8,
    "shapes": {
      "arrow": { "file": "cursor.svg", "hotspot": [3, 3] },
      "hand": { "file": "cursor-hand.svg", "hotspot": [11, 3] },
      "text": { "file": "cursor-text.svg", "hotspot": [15, 15] }
    }
  },
  "caret": {
    "width": 1,
    "solidFrames": 30,
    "blinkFrames": 30
  },
  "loop": {
    "frames": 40
  },
  "phone": {
    "art": "iphone-18-pro.webp",
    "artSize": [978, 2000],
    "screen": [52, 50, 874, 1900],
    "screenRadius": 135,
    "shadow": "drop-shadow(0 2px 3px rgb(0 0 0 / 0.08)) drop-shadow(0 16px 28px rgb(0 0 0 / 0.14))",
    "statusBar": {
      "time": "9:41",
      "font": "590 17.67px/22px -apple-system, \"SF Pro\", system-ui, sans-serif",
      "inkThreshold": 0.55,
      "wifi": "status-wifi.svg",
      "battery": "status-battery.svg"
    },
    "finger": {
      "size": 44,
      "lead": 6,
      "lift": 12,
      "from": 1.3,
      "liftTo": 1.15,
      "fill": "rgb(110 110 120 / 0.38)",
      "border": "2px solid rgb(255 255 255 / 0.9)",
      "shadow": "0 1px 6px rgb(0 0 0 / 0.22)"
    }
  }
}
