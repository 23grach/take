{
  "stage": {
    "size": [1920, 1080],
    "output": [2560, 1440],
    "background": "#f2f2f2",
    "padding": 64
  },
  "window": {
    "radius": 14,
    "background": "#ffffff",
    "shadow": "0 1px 2px rgb(0 0 0 / 0.05), 0 12px 32px -6px rgb(0 0 0 / 0.12)",
    "border": "1px solid #e6e6e6",
    "bar": { "height": 40, "background": "#f3f2f0", "divider": "#e3e1dc" },
    "dots": {
      "size": 12,
      "gap": 8,
      "outlineWidth": 0.5,
      "close": { "fill": "#ff5f57", "outline": "#e0443e" },
      "minimize": { "fill": "#febc2e", "outline": "#dea123" },
      "zoom": { "fill": "#28c840", "outline": "#1aab29" }
    },
    "address": { "show": true, "width": 420, "height": 26, "background": "#ffffff", "color": "#8a8794", "font": "500 13px system-ui, -apple-system, sans-serif" }
  },
  "dark": {
    "stage": { "background": "#181b25" },
    "window": {
      "background": "#000000",
      "shadow": "0 1px 2px rgb(0 0 0 / 0.3), 0 16px 40px -8px rgb(0 0 0 / 0.5)",
      "border": "1px solid rgb(255 255 255 / 0.1)",
      "bar": { "background": "#262a35", "divider": "#13151c" },
      "address": { "background": "#343846", "color": "#9a9eac" }
    }
  },
  "cursor": {
    "art": "system",
    "size": 24,
    "pressScale": 0.86,
    "hideFade": 8,
    "shapes": {
      "arrow": { "file": "cursor.svg", "hotspot": [3, 3] },
      "hand": { "file": "cursor-hand.svg", "hotspot": [11, 3] },
      "text": { "file": "cursor-text.svg", "hotspot": [15, 15] }
    }
  },
  "caret": {
    "width": 1,
    "solidFrames": 30,
    "blinkFrames": 30
  },
  "loop": {
    "frames": 40
  },
  "phone": {
    "art": "iphone-18-pro.webp",
    "artSize": [978, 2000],
    "screen": [52, 50, 874, 1900],
    "screenRadius": 135,
    "shadow": "drop-shadow(0 2px 3px rgb(0 0 0 / 0.08)) drop-shadow(0 16px 28px rgb(0 0 0 / 0.14))",
    "statusBar": {
      "time": "9:41",
      "font": "590 17.67px/22px -apple-system, \"SF Pro\", system-ui, sans-serif",
      "wifi": "status-wifi.svg",
      "battery": "status-battery.svg"
    },
    "ink": { "toDark": 0.45, "toLight": 0.6, "fade": 10 },
    "edge": { "blur": 8, "depth": 30, "steps": 8 },
    "safari": {
      "morph": 18,
      "collapseAfter": 12,
      "font": "500 17px/22px \"SF Pro Text\", -apple-system, system-ui, sans-serif",
      "pillFont": "510 12px/16px \"SF Pro\", -apple-system, system-ui, sans-serif",
      "pillPadding": 18,
      "pillWidth": 96
    },
    "glass": {
      "blur": 1.2,
      "bevel": 0.8,
      "curve": 2,
      "rim": 0.8,
      "rimReach": 0.8,
      "light": { "gain": 0.33, "lift": 0.66, "chroma": 0.85, "rim": 0.55 },
      "dark": { "gain": 0.75, "lift": 0.07, "chroma": 1, "rim": 0.35 }
    },
    "keyboard": {
      "pressFrames": 7,
      "lead": 4,
      "blur": 5,
      "letterFont": "400 25px/30px \"SF Compact Text\", -apple-system, system-ui, sans-serif",
      "labelFont": "500 16px/20px \"SF Pro Text\", -apple-system, system-ui, sans-serif",
      "suggestionFont": "400 18px/22px \"SF Pro\", -apple-system, system-ui, sans-serif",
      "calloutFont": "400 34px/1 \"SF Compact Text\", -apple-system, system-ui, sans-serif"
    },
    "icons": {
      "back": "ios/safari-back.svg",
      "tabs": "ios/safari-tabs.svg",
      "menu": "ios/safari-menu.svg",
      "reload": "ios/safari-reload.svg",
      "up": "ios/accessory-up.svg",
      "down": "ios/accessory-down.svg",
      "done": "ios/accessory-done.svg",
      "shift": "ios/key-shift.svg",
      "shiftOn": "ios/key-shift-on.svg",
      "symbols": "ios/key-symbols.svg",
      "delete": "ios/key-delete.svg",
      "return": "ios/key-return.svg",
      "emoji": "ios/key-emoji.svg",
      "mic": "ios/key-mic.svg"
    },
    "light": {
      "ink": "#000",
      "glyph": "#1b1b1b",
      "pillText": "#1a1a11",
      "accessoryGlyph": "#1a1a1a",
      "glassShadow": "rgb(0 0 0 / 0.08)",
      "kbBackground": "rgb(218 218 218 / 0.75)",
      "kbBorder": "rgb(255 255 255 / 0.7)",
      "kbInsetSoft": "#fff",
      "kbInsetHair": "rgb(255 255 255 / 0)",
      "key": "rgb(255 255 255 / 0.89)",
      "keyPressed": "rgb(178 180 186 / 0.95)",
      "keyText": "rgb(0 0 0 / 0.65)",
      "suggestion": "#000",
      "divider": "rgb(0 0 0 / 0.18)",
      "kbIcon": "rgb(0 0 0 / 0.5)",
      "callout": "#fff"
    },
    "dark": {
      "ink": "#fff",
      "glyph": "#fff",
      "pillText": "#fff",
      "accessoryGlyph": "#fff",
      "glassShadow": "rgb(0 0 0 / 0)",
      "kbBackground": "rgb(28 28 28 / 0.86)",
      "kbBorder": "rgb(255 255 255 / 0)",
      "kbInsetSoft": "rgb(255 255 255 / 0)",
      "kbInsetHair": "rgb(255 255 255 / 0.5)",
      "key": "rgb(255 255 255 / 0.27)",
      "keyPressed": "rgb(255 255 255 / 0.5)",
      "keyText": "#fff",
      "suggestion": "#fff",
      "divider": "rgb(255 255 255 / 0.3)",
      "kbIcon": "rgb(255 255 255 / 0.5)",
      "callout": "rgb(108 108 108)"
    },
    "finger": {
      "size": 44,
      "lead": 6,
      "lift": 12,
      "from": 1.3,
      "liftTo": 1.15,
      "fill": "rgb(110 110 120 / 0.38)",
      "border": "2px solid rgb(255 255 255 / 0.9)",
      "shadow": "0 1px 6px rgb(0 0 0 / 0.22)"
    }
  }
}
