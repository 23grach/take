{
  "name": "take",
  "version": "0.2.3",
  "private": true,
  "description": "Turns a plain-text scenario into a finished demo video recorded from the real app.",
  "type": "module",
  "bin": {
    "take": "bin/take"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "take": "node bin/take",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test --test-timeout=180000 \"test/**/*.test.ts\"",
    "demo": "node examples/demo-app/serve.mjs",
    "postinstall": "node src/install-browser.ts && node src/install-ffmpeg.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "ffmpeg-static": false,
    "@ffprobe-installer/darwin-arm64": false,
    "@ffprobe-installer/darwin-x64": false,
    "@ffprobe-installer/linux-arm64": false,
    "@ffprobe-installer/linux-x64": false
  }
}
